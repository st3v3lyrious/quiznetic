{
  "name": "quiznetic-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.cjs",
  "scripts": {
    "lint": "echo 'No function lint configured'",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "account:delete": "node scripts/delete-account.cjs",
    "test:deletion": "node --test tests/delete-account.test.cjs",
    "test:deletion:emulator": "../firestore_tests/node_modules/.bin/firebase emulators:exec --config ../firebase.deletion.json --only auth,firestore --project demo-quiznetic-deletion \"npm run test:deletion\""
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  }
}
