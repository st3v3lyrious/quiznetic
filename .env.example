# Copy this file to .env and fill your real values.
# Flutter/Dart values are loaded with:
#   flutter run --dart-define-from-file=.env

# Core feature flags
ENABLE_BACKEND_SUBMIT_SCORE=false
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=true
ENABLE_APPLE_SIGN_IN=false

# Auth
GOOGLE_OAUTH_CLIENT_ID=

# Ads / Monetization feature flags
ENABLE_ADS=false
ENABLE_RESULT_INTERSTITIAL_ADS=false
ALLOW_LIVE_AD_UNITS_IN_DEBUG=false
ADS_ANDROID_TEST_DEVICE_IDS=
ADS_IOS_TEST_DEVICE_IDS=
# Supported values: eea, uk (alias of eea), regulated_us_state, other
ADS_CONSENT_DEBUG_GEOGRAPHY=
ADS_TAG_FOR_UNDER_AGE_OF_CONSENT=false
ENABLE_IAP=false
ENABLE_REWARDED_HINTS=false
REWARDED_HINTS_PER_SESSION=3
ENABLE_PAID_HINTS=false
IAP_REMOVE_ADS_PRODUCT_ID=quiznetic.remove_ads_lifetime
IAP_HINT_CONSUMABLE_PRODUCT_ID=quiznetic.hint_single
PAID_HINT_PRICE_USD_CENTS=50

# AdMob app IDs (native metadata)
ADS_ANDROID_APP_ID=
ADS_IOS_APP_ID=

# AdMob unit IDs (Dart env)
ADS_ANDROID_BANNER_UNIT_ID=
ADS_IOS_BANNER_UNIT_ID=
ADS_ANDROID_HOME_BANNER_UNIT_ID=
ADS_IOS_HOME_BANNER_UNIT_ID=
ADS_ANDROID_RESULT_BANNER_UNIT_ID=
ADS_IOS_RESULT_BANNER_UNIT_ID=
ADS_ANDROID_RESULT_INTERSTITIAL_UNIT_ID=
ADS_IOS_RESULT_INTERSTITIAL_UNIT_ID=
ADS_ANDROID_REWARDED_HINT_UNIT_ID=
ADS_IOS_REWARDED_HINT_UNIT_ID=

# Firebase web options
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

# Firebase Android options
FIREBASE_PROJECT_NUMBER=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
# Expected to match FIREBASE_PROJECT_NUMBER.
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PROJECT_ID=
FIREBASE_ANDROID_STORAGE_BUCKET=
FIREBASE_ANDROID_PACKAGE_NAME=com.eirenya.quiznetic
FIREBASE_ANDROID_CERT_HASH=
FIREBASE_ANDROID_OAUTH_CLIENT_ID=

# Firebase iOS options
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=
# Expected format: <client-id>.apps.googleusercontent.com
FIREBASE_IOS_OAUTH_CLIENT_ID=
